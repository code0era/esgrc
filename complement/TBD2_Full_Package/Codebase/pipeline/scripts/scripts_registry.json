    "step2": "data_preparation - inputs: module_values.csv + config JSON. outputs: filtered_metrics.csv + filtered_groups.csv + filtered_sub_modules.csv + data_for_risk_assessment.csv",
    "step3": "correlation_chaid_ft - inputs: 3 filtered CSVs. outputs: correlation.txt + trends.txt + inconsistencies.txt + chaid.txt",
    "step4": "spc_rpn - inputs: raw metrics CSV. outputs: metrics_summary.txt + rpn.pdf (user download)",
    "step5": "regression - inputs: module_values.csv + config JSON. outputs: module_model_summary.txt"
  },
  "_r2_path_conventions": {
    "run_scoped": "org/{org_id}/runs/{run_id}/step_{step_number}/{filename}",
