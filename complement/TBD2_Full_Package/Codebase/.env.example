# ─── TBD2 Environment Variables ───────────────────────────────────────────────
# Copy to .env and fill in all required values before starting.
# NEVER commit .env to git.

# ── Database ──────────────────────────────────────────────────────────────────
# Generate password: python -c "import secrets; print(secrets.token_urlsafe(32))"
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
DATABASE_URL=postgresql+psycopg://tbd2:REPLACE_WITH_STRONG_PASSWORD@postgres:5432/tbd2

# ── Auth ──────────────────────────────────────────────────────────────────────
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=REPLACE_WITH_64_CHAR_HEX_STRING

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
# Required by docker-compose.prod.yml (redis --requirepass); leave blank in dev.
# Generate: python -c "import secrets; print(secrets.token_urlsafe(24))"
REDIS_PASSWORD=

# ── Anthropic ────────────────────────────────────────────────────────────────
# Get from: https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-REPLACE_WITH_YOUR_KEY

# Model overrides (defaults are fine)
ORCHESTRATOR_MODEL=claude-sonnet-5
SPECIALIST_MODEL=claude-haiku-4-5

# ── Cloudflare R2 ─────────────────────────────────────────────────────────────
# Get from: Cloudflare Dashboard → R2 → Manage API Tokens
CLOUDFLARE_R2_BUCKET=tbd2-pipeline
CLOUDFLARE_R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
CLOUDFLARE_R2_ACCESS_KEY=REPLACE_WITH_R2_ACCESS_KEY
CLOUDFLARE_R2_SECRET_KEY=REPLACE_WITH_R2_SECRET_KEY
# S3 addressing style for the object-store client (pipeline/tasks/r2.py).
# Leave blank for real Cloudflare R2. Set to "path" only when running against
# local MinIO - see docker-compose.local.yml.
S3_ADDRESSING_STYLE=

# ── Langfuse (optional — LLM observability) ───────────────────────────────────
# Free tier at https://langfuse.com — ~50K traces/month
# Leave blank to disable tracing (pipeline still works without it)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ── Sentry (optional — error tracking) ───────────────────────────────────────
SENTRY_DSN=

# ── App behaviour ─────────────────────────────────────────────────────────────
# AGENT settings (ESGRC backend)
AGENT_ENABLED=true
AGENT_HOUR=2
AGENT_MINUTE=0
AGENT_TIMEZONE=UTC
LLM_AGENT_ENABLED=false

# CORS — set to your frontend URL in production
# Leave blank in dev (allows all origins)
ALLOWED_ORIGINS=

# ── Demo mode ─────────────────────────────────────────────────────────────────
# DEMO_MODE=true → scripts return fixture outputs in 2 seconds (no real processing)
# NEVER ship DEMO_MODE=true to the real client
DEMO_MODE=false
DEMO_SCRIPT_DELAY=2

# ── Script execution ──────────────────────────────────────────────────────────
SCRIPTS_DIR=/app/pipeline/scripts
SCRIPT_TIMEOUT=3600
